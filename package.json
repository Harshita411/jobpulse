{
  "name": "jobpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/api.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "dev": "node --watch --env-file-if-exists=.env src/api.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.js",
    "web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "test:web": "npm --prefix web run test:e2e"
  },
  "dependencies": {
    "bullmq": "5.81.5",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "mongodb": "7.8.0",
    "multer": "2.5.0"
  }
}
