PORT=3000
REDIS_URL=redis://127.0.0.1:6380
MONGODB_URL=mongodb://127.0.0.1:27018/jobpulse
# Browser origin accepted for state-changing requests (no trailing slash).
APP_ORIGIN=http://localhost:5173
# Fixed server-side session lifetime, 5–60 minutes. No JWT/signing secret is needed.
SESSION_TTL_MINUTES=30
# false only for this loopback HTTP setup; HTTPS deployments require true.
SESSION_COOKIE_SECURE=false
